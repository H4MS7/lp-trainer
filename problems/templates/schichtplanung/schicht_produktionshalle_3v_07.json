    "b2":  {"min": 6, "max": 20, "label": "Mindestbesetzung Qualitätskontrolle"},
    "a31": {"min": 2, "max": 5, "label": "Logistiker pro Frühschicht"},
    "a32": {"min": 2, "max": 4, "label": "Logistiker pro Spätschicht"},
