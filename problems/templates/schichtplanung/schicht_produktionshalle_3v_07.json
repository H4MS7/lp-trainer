    {"type": ">=", "label": "Mindestbesetzung Logistik", "row": ["a31","a32","a33"], "rhs": "b3"}
  ],
  "coefficients": {
    "c1":  {"min": 120, "max": 220, "label": "Kosten Frühschicht (€)"},
    "c2":  {"min": 130, "max": 240, "label": "Kosten Spätschicht (€)"},
    "c3":  {"min": 170, "max": 300, "label": "Kosten Nachtschicht (€)"},
    "a11": {"min": 4, "max": 10, "label": "Maschinenbediener pro Frühschicht"},
    "a12": {"min": 3, "max": 8, "label": "Maschinenbediener pro Spätschicht"},
