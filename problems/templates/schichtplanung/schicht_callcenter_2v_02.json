{
  "id": "schicht_callcenter_2v_02",
  "typ": "Schichtplanung",
  "optimierungsziel": "minimieren",
  "numVars": 2,
  "variablen": ["x1 = Anzahl Frühschichten", "x2 = Anzahl Spätschichten"],
  "objective": ["c1", "c2"],
  "constraints": [
    {"type": ">=", "label": "Mindestbesetzung Vormittag", "row": ["a11","a12"], "rhs": "b1"},
