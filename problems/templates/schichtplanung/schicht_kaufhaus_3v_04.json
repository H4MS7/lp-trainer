    "zielfunktion": [
      {"text": "Frühschicht kostet {c1} €", "bedeutung": "{c1} × x₁"},
      {"text": "Mittagsschicht kostet {c2} €", "bedeutung": "{c2} × x₂"},
      {"text": "Abendschicht kostet {c3} €", "bedeutung": "{c3} × x₃"}
    ],
    "nebenbedingungen": [
      [
        {"text": "{a11} Verkäufer bereit, jede Mittagsschicht {a12} und jede Abendschicht {a13}", "bedeutung": "{a11}x₁ + {a12}x₂ + {a13}x₃"},
        {"text": "{b1} Verkäufer werden benötigt", "bedeutung": "≥ {b1}"}
      ],
      [
        {"text": "{a21} Kassierer bereit, jede Mittagsschicht {a22} und jede Abendschicht {a23}", "bedeutung": "{a21}x₁ + {a22}x₂ + {a23}x₃"},
        {"text": "{b2} Kassierer werden benötigt", "bedeutung": "≥ {b2}"}
