{
  "id": "schicht_krankenhaus_2v_01",
  "typ": "Schichtplanung",
  "optimierungsziel": "minimieren",
  "numVars": 2,
  "variablen": ["x1 = Anzahl Tagschichten", "x2 = Anzahl Nachtschichten"],
  "objective": ["c1", "c2"],
  "constraints": [
    {"type": ">=", "label": "Mindestbesetzung Tag", "row": ["a11","a12"], "rhs": "b1"},
