  "titel": "Pflegeheim – Drei-Schicht-Planung",
  "beschreibung": "Ein Pflegeheim plant die Besetzung über drei Schichten. Eine Frühschicht kostet {c1} €, eine Spätschicht kostet {c2} € und eine Nachtschicht kostet {c3} €. Jede Frühschicht stellt {a11} Pflegekräfte bereit, jede Spätschicht {a12} und jede Nachtschicht {a13}. Mindestens {b1} Pflegekräfte werden benötigt. Jede Frühschicht stellt {a21} Betreuer bereit, jede Spätschicht {a22} und jede Nachtschicht {a23}. Mindestens {b2} Betreuer werden benötigt. Jede Frühschicht stellt {a31} Hauswirtschaftskräfte bereit, jede Spätschicht {a32} und jede Nachtschicht {a33}. Mindestens {b3} Hauswirtschaftskräfte werden benötigt.",
  "hinweis": "Minimiere die Gesamtkosten bei Einhaltung der Mindestbesetzung für Pflege, Betreuung und Hauswirtschaft.",
  "highlights": {
    "zielfunktion": [
      {"text": "Frühschicht kostet {c1} €", "bedeutung": "{c1} × x₁"},
      {"text": "Spätschicht kostet {c2} €", "bedeutung": "{c2} × x₂"},
      {"text": "Nachtschicht kostet {c3} €", "bedeutung": "{c3} × x₃"}
    ],
    "nebenbedingungen": [
      [
        {"text": "{a11} Pflegekräfte bereit, jede Spätschicht {a12} und jede Nachtschicht {a13}", "bedeutung": "{a11}x₁ + {a12}x₂ + {a13}x₃"},
        {"text": "{b1} Pflegekräfte werden benötigt", "bedeutung": "≥ {b1}"}
      ],
      [
        {"text": "{a21} Betreuer bereit, jede Spätschicht {a22} und jede Nachtschicht {a23}", "bedeutung": "{a21}x₁ + {a22}x₂ + {a23}x₃"},
        {"text": "{b2} Betreuer werden benötigt", "bedeutung": "≥ {b2}"}
      ],
      [
        {"text": "{a31} Hauswirtschaftskräfte bereit, jede Spätschicht {a32} und jede Nachtschicht {a33}", "bedeutung": "{a31}x₁ + {a32}x₂ + {a33}x₃"},
        {"text": "{b3} Hauswirtschaftskräfte werden benötigt", "bedeutung": "≥ {b3}"}
      ]
    ]
  }
