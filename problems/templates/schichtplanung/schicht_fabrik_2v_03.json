  ],
  "coefficients": {
    "c1":  {"min": 100, "max": 180, "label": "Kosten Frühschicht (€)"},
    "c2":  {"min": 140, "max": 250, "label": "Kosten Nachtschicht (€)"},
    "a11": {"min": 4, "max": 10, "label": "Produktionsarbeiter pro Frühschicht"},
    "a12": {"min": 2, "max": 5, "label": "Produktionsarbeiter pro Nachtschicht"},
    "b1":  {"min": 30, "max": 80, "label": "Mindestbesetzung Produktion"},
    "a21": {"min": 1, "max": 4, "label": "Wartungstechniker pro Frühschicht"},
    "a22": {"min": 2, "max": 6, "label": "Wartungstechniker pro Nachtschicht"},
    "b2":  {"min": 10, "max": 40, "label": "Mindestbesetzung Wartung"}
  },
  "titel": "Fabrik – Schichtplanung",
  "beschreibung": "Eine Fabrik plant die Schichtbesetzung für Produktion und Wartung. Eine Frühschicht kostet {c1} €, eine Nachtschicht kostet {c2} €. Jede Frühschicht stellt {a11} Produktionsarbeiter bereit, jede Nachtschicht stellt {a12} Produktionsarbeiter bereit. Mindestens {b1} Produktionsarbeiter werden benötigt. Jede Frühschicht stellt {a21} Wartungstechniker bereit, jede Nachtschicht stellt {a22} Wartungstechniker bereit. Mindestens {b2} Wartungstechniker werden benötigt.",
  "hinweis": "Minimiere die Schichtkosten bei Einhaltung der Mindestbesetzung für Produktion und Wartung.",
  "highlights": {
    "zielfunktion": [
      {"text": "Frühschicht kostet {c1} €", "bedeutung": "{c1} × x₁"},
      {"text": "Nachtschicht kostet {c2} €", "bedeutung": "{c2} × x₂"}
    ],
    "nebenbedingungen": [
      [
        {"text": "{a11} Produktionsarbeiter bereit", "bedeutung": "{a11}x₁"},
        {"text": "{a12} Produktionsarbeiter bereit", "bedeutung": "+ {a12}x₂"},
        {"text": "{b1} Produktionsarbeiter werden benötigt", "bedeutung": "≥ {b1}"}
      ],
      [
        {"text": "{a21} Wartungstechniker bereit", "bedeutung": "{a21}x₁"},
        {"text": "{a22} Wartungstechniker bereit", "bedeutung": "+ {a22}x₂"},
        {"text": "{b2} Wartungstechniker werden benötigt", "bedeutung": "≥ {b2}"}
      ]
    ]
  }
}
