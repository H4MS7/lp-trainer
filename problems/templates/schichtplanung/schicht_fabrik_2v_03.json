{
  "id": "schicht_fabrik_2v_03",
  "typ": "Schichtplanung",
  "optimierungsziel": "minimieren",
  "numVars": 2,
  "variablen": ["x1 = Anzahl Frühschichten", "x2 = Anzahl Nachtschichten"],
  "objective": ["c1", "c2"],
