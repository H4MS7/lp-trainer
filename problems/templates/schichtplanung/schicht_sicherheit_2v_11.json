      {"text": "Nachtschicht kostet {c2} €", "bedeutung": "{c2} × x₂"}
    ],
    "nebenbedingungen": [
      [
        {"text": "{a11} Wachleute für den Objektschutz bereit", "bedeutung": "{a11}x₁"},
        {"text": "{a12} Wachleute für den Objektschutz bereit", "bedeutung": "+ {a12}x₂"},
        {"text": "{b1} Wachleute für den Objektschutz werden benötigt", "bedeutung": "≥ {b1}"}
      ],
      [
        {"text": "{a21} Empfangskräfte bereit", "bedeutung": "{a21}x₁"},
        {"text": "{a22} Empfangskräfte bereit", "bedeutung": "+ {a22}x₂"},
        {"text": "{b2} Empfangskräfte werden benötigt", "bedeutung": "≥ {b2}"}
      ]
    ]
  }
