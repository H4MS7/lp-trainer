  ],
  "coefficients": {
    "c1":  {"min": 8, "max": 20,  "label": "Ertrag Kräuter (Tsd. €/ha)"},
    "c2":  {"min": 4, "max": 12,  "label": "Ertrag Gemüse (Tsd. €/ha)"},
    "a11": {"min": 1, "max": 2,   "label": "Flächenbedarf Kräuter (ha/ha)"},
    "a12": {"min": 1, "max": 2,   "label": "Flächenbedarf Gemüse (ha/ha)"},
    "b1":  {"min": 10, "max": 80,  "label": "Gesamtfläche (ha)"},
    "a21": {"min": 4, "max": 10,  "label": "Erntehelfer Kräuter (Personen/ha)"},
    "a22": {"min": 2, "max": 6,   "label": "Erntehelfer Gemüse (Personen/ha)"},
    "b2":  {"min": 20, "max": 100, "label": "Verfügbare Erntehelfer (Personen)"}
  },
  "titel": "Gärtnerei – Kräuter und Gemüse",
  "beschreibung": "Eine Gärtnerei teilt ihre Fläche zwischen Kräuteranbau und Gemüseanbau auf. Kräuter bringen {c1} Tsd. € Ertrag pro Hektar, Gemüse bringt {c2} Tsd. € pro Hektar. Der Flächenbedarf beträgt {a11} Hektar pro Hektar Kräuter und {a12} Hektar pro Hektar Gemüse. Die Gesamtfläche beträgt {b1} Hektar. Für die Ernte werden {a21} Personen pro Hektar Kräuter und {a22} Personen pro Hektar Gemüse benötigt. Insgesamt stehen {b2} Erntehelfer zur Verfügung.",
  "hinweis": "Maximiere den Gesamtertrag unter Beachtung der Flächen- und Personalbeschränkungen.",
  "highlights": {
    "zielfunktion": [
      {"text": "Kräuter bringen {c1} Tsd. € Ertrag pro Hektar", "bedeutung": "{c1} × x₁"},
      {"text": "Gemüse bringt {c2} Tsd. € pro Hektar", "bedeutung": "{c2} × x₂"}
    ],
    "nebenbedingungen": [
      [
        {"text": "{a11} Hektar pro Hektar Kräuter", "bedeutung": "{a11}x₁"},
        {"text": "{a12} Hektar pro Hektar Gemüse", "bedeutung": "+ {a12}x₂"},
        {"text": "{b1} Hektar", "bedeutung": "≤ {b1}"}
      ],
      [
        {"text": "{a21} Personen pro Hektar Kräuter", "bedeutung": "{a21}x₁"},
        {"text": "{a22} Personen pro Hektar Gemüse", "bedeutung": "+ {a22}x₂"},
        {"text": "{b2} Erntehelfer zur Verfügung", "bedeutung": "≤ {b2}"}
      ]
    ]
  }
}
