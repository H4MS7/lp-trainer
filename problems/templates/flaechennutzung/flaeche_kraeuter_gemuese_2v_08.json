{
  "id": "flaeche_kraeuter_gemuese_2v_08",
  "typ": "Flächennutzung",
  "optimierungsziel": "maximieren",
  "numVars": 2,
  "variablen": ["x1 = Hektar Kräuteranbau", "x2 = Hektar Gemüseanbau"],
  "objective": ["c1", "c2"],
  "constraints": [
    {"type": "<=", "label": "Gesamtfläche", "row": ["a11","a12"], "rhs": "b1"},
