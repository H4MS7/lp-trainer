        {"text": "{a11} m³ Abwasser pro Einheit", "bedeutung": "{a11}x₁"},
        {"text": "{a12} m³", "bedeutung": "+ {a12}x₂"},
        {"text": "{b1} m³", "bedeutung": "≤ {b1}"}
      ],
      [
        {"text": "{a21} Tonnen Abgase pro Einheit", "bedeutung": "{a21}x₁"},
        {"text": "{a22} Tonnen", "bedeutung": "+ {a22}x₂"},
        {"text": "{b2} Tonnen", "bedeutung": "≤ {b2}"}
      ]
    ]
  }
