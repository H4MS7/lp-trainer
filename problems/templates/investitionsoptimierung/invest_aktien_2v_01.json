  "optimierungsziel": "maximieren",
  "numVars": 2,
  "variablen": ["x1 = Betrag in Aktien (Tsd. EUR)", "x2 = Betrag in Anleihen (Tsd. EUR)"],
  "objective": ["c1", "c2"],
