  ],
  "coefficients": {
    "c1":  {"min": 40, "max": 120, "label": "Gewinn/Tisch (€)"},
    "c2":  {"min": 15, "max": 50,  "label": "Gewinn/Stuhl (€)"},
    "a11": {"min": 3, "max": 10,   "label": "Holz/Tisch (m²)"},
    "a12": {"min": 1, "max": 4,    "label": "Holz/Stuhl (m²)"},
    "b1":  {"min": 80, "max": 300, "label": "Holzvorrat (m²)"},
    "a21": {"min": 3, "max": 8,    "label": "Arbeitszeit/Tisch (h)"},
