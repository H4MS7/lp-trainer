    "a11": {"min": 1, "max": 3,      "label": "Zellstoff/t Druckpapier (t)"},
    "a12": {"min": 2, "max": 5,      "label": "Zellstoff/t Karton (t)"},
    "b1":  {"min": 30, "max": 120,   "label": "Zellstoffvorrat (t)"},
    "a21": {"min": 2, "max": 6,      "label": "Trocknungszeit/t Druckpapier (h)"},
