      ],
      [
        {"text": "Plakats dauert {a21} Minuten", "bedeutung": "{a21}x₁"},
        {"text": "Broschuere {a22} Minuten", "bedeutung": "+ {a22}x₂"},
        {"text": "{b2} Minuten", "bedeutung": "≤ {b2}"}
      ]
    ]
  }
