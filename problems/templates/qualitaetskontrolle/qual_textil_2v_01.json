{
  "id": "qual_textil_2v_01",
  "typ": "Qualitätskontrolle",
  "optimierungsziel": "minimieren",
  "numVars": 2,
  "variablen": ["x1 = Anzahl Zugfestigkeitstests", "x2 = Anzahl Farbechtheitstest"],
  "objective": ["c1", "c2"],
  "constraints": [
    {"type": ">=", "label": "Mindest-Qualitätsindex", "row": ["a11","a12"], "rhs": "b1"},
    {"type": "<=", "label": "Laborzeit", "row": ["a21","a22"], "rhs": "b2"}
  ],
  "coefficients": {
    "c1":  {"min": 3, "max": 10,  "label": "Kosten Zugfestigkeit (€/Test)"},
    "c2":  {"min": 2, "max": 8,   "label": "Kosten Farbechtheit (€/Test)"},
    "a11": {"min": 3, "max": 8,   "label": "Qualitätsindex Zugfestigkeit"},
    "a12": {"min": 2, "max": 6,   "label": "Qualitätsindex Farbechtheit"},
    "b1":  {"min": 40, "max": 150, "label": "Mindest-Qualitätsindex"},
    "a21": {"min": 2, "max": 5,   "label": "Laborzeit Zugfestigkeit (min)"},
    "a22": {"min": 1, "max": 4,   "label": "Laborzeit Farbechtheit (min)"},
    "b2":  {"min": 30, "max": 100, "label": "Laborzeit (min)"}
  },
  "titel": "Textilprüfung – Stoffqualität",
  "beschreibung": "Ein Textilhersteller prüft Stoffe mit Zugfestigkeitstests und Farbechtheitstest. Ein Zugfestigkeitstest kostet {c1} €, ein Farbechtheitstest kostet {c2} €. Der Zugfestigkeitstest liefert {a11} Qualitätsindexpunkte, der Farbechtheitstest liefert {a12} Qualitätsindexpunkte. Der Mindest-Qualitätsindex beträgt {b1} Punkte. Ein Zugfestigkeitstest dauert {a21} Minuten, ein Farbechtheitstest dauert {a22} Minuten. Die verfügbare Laborzeit beträgt {b2} Minuten.",
  "hinweis": "Minimiere die Prüfkosten bei ausreichendem Qualitätsindex und begrenzter Laborzeit.",
  "highlights": {
    "zielfunktion": [
      {"text": "Zugfestigkeitstest kostet {c1} €", "bedeutung": "{c1} × x₁"},
      {"text": "Farbechtheitstest kostet {c2} €", "bedeutung": "{c2} × x₂"}
    ],
    "nebenbedingungen": [
      [
        {"text": "{a11} Qualitätsindexpunkte", "bedeutung": "{a11}x₁"},
        {"text": "{a12} Qualitätsindexpunkte", "bedeutung": "+ {a12}x₂"},
        {"text": "{b1} Punkte", "bedeutung": "≥ {b1}"}
      ],
      [
        {"text": "{a21} Minuten", "bedeutung": "{a21}x₁"},
        {"text": "{a22} Minuten", "bedeutung": "+ {a22}x₂"},
        {"text": "{b2} Minuten", "bedeutung": "≤ {b2}"}
      ]
    ]
  }
}
