{
  "id": "qual_halbleiter_2v_01",
  "typ": "Qualitätskontrolle",
  "optimierungsziel": "minimieren",
  "numVars": 2,
  "variablen": ["x1 = Anzahl optische Prüfungen", "x2 = Anzahl elektrische Prüfungen"],
  "objective": ["c1", "c2"],
  "constraints": [
    {"type": ">=", "label": "Fehlererkennungsrate", "row": ["a11","a12"], "rhs": "b1"},
    {"type": "<=", "label": "Prüfzeit", "row": ["a21","a22"], "rhs": "b2"}
  ],
  "coefficients": {
    "c1":  {"min": 2, "max": 8,   "label": "Kosten optisch (€/Prüfung)"},
    "c2":  {"min": 3, "max": 12,  "label": "Kosten elektrisch (€/Prüfung)"},
    "a11": {"min": 2, "max": 6,   "label": "Fehler optisch (%)"},
    "a12": {"min": 3, "max": 10,  "label": "Fehler elektrisch (%)"},
    "b1":  {"min": 40, "max": 150, "label": "Mindest-Erkennungsrate (%)"},
    "a21": {"min": 1, "max": 4,   "label": "Zeit optisch (min)"},
    "a22": {"min": 2, "max": 6,   "label": "Zeit elektrisch (min)"},
    "b2":  {"min": 30, "max": 120, "label": "Max. Prüfzeit (min)"}
  },
  "titel": "Halbleiterfertigung – Qualitätsprüfung",
  "beschreibung": "Ein Halbleiterhersteller kombiniert optische und elektrische Prüfverfahren. Eine optische Prüfung kostet {c1} €, eine elektrische Prüfung kostet {c2} €. Die optische Prüfung erkennt {a11} % der Fehler, die elektrische Prüfung erkennt {a12} % der Fehler. Mindestens {b1} % der Fehler müssen erkannt werden. Die optische Prüfung dauert {a21} Minuten, die elektrische Prüfung dauert {a22} Minuten. Die maximale Prüfzeit beträgt {b2} Minuten.",
  "hinweis": "Minimiere die Prüfkosten bei ausreichender Fehlererkennung und begrenzter Prüfzeit.",
  "highlights": {
    "zielfunktion": [
      {"text": "optische Prüfung kostet {c1} €", "bedeutung": "{c1} × x₁"},
      {"text": "elektrische Prüfung kostet {c2} €", "bedeutung": "{c2} × x₂"}
    ],
    "nebenbedingungen": [
      [
        {"text": "{a11} % der Fehler", "bedeutung": "{a11}x₁"},
        {"text": "{a12} % der Fehler", "bedeutung": "+ {a12}x₂"},
        {"text": "{b1} % der Fehler müssen erkannt werden", "bedeutung": "≥ {b1}"}
      ],
      [
        {"text": "{a21} Minuten", "bedeutung": "{a21}x₁"},
        {"text": "{a22} Minuten", "bedeutung": "+ {a22}x₂"},
        {"text": "{b2} Minuten", "bedeutung": "≤ {b2}"}
      ]
    ]
  }
}
