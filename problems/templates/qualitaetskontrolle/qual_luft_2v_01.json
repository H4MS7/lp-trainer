{
  "id": "qual_luft_2v_01",
  "typ": "Qualitätskontrolle",
  "optimierungsziel": "minimieren",
  "numVars": 2,
  "variablen": ["x1 = Anzahl Feinstaubmessungen", "x2 = Anzahl Gasspektroskopien"],
  "objective": ["c1", "c2"],
  "constraints": [
    {"type": ">=", "label": "Mindest-Schadstofferfassung", "row": ["a11","a12"], "rhs": "b1"},
    {"type": "<=", "label": "Messgerätezeit", "row": ["a21","a22"], "rhs": "b2"}
  ],
  "coefficients": {
    "c1":  {"min": 2, "max": 8,   "label": "Kosten Feinstaubmessung (€/Messung)"},
    "c2":  {"min": 5, "max": 14,  "label": "Kosten Gasspektroskopie (€/Messung)"},
    "a11": {"min": 3, "max": 7,   "label": "Schadstofferfassung Feinstaub (%)"},
    "a12": {"min": 4, "max": 10,  "label": "Schadstofferfassung Gas (%)"},
    "b1":  {"min": 40, "max": 160, "label": "Mindest-Schadstofferfassung (%)"},
    "a21": {"min": 1, "max": 3,   "label": "Messzeit Feinstaub (Stunden)"},
    "a22": {"min": 2, "max": 5,   "label": "Messzeit Gas (Stunden)"},
    "b2":  {"min": 20, "max": 80,  "label": "Messgerätezeit (Stunden)"}
  },
  "titel": "Luftqualität – Emissionsüberwachung",
  "beschreibung": "Eine Umweltbehörde überwacht die Luftqualität mit Feinstaubmessungen und Gasspektroskopien. Eine Feinstaubmessung kostet {c1} €, eine Gasspektroskopie kostet {c2} €. Die Feinstaubmessung erfasst {a11} % der Schadstoffe, die Gasspektroskopie erfasst {a12} % der Schadstoffe. Die Mindest-Schadstofferfassung beträgt {b1} %. Eine Feinstaubmessung dauert {a21} Stunden, eine Gasspektroskopie dauert {a22} Stunden. Die Messgerätezeit beträgt {b2} Stunden.",
  "hinweis": "Minimiere die Messkosten bei ausreichender Schadstofferfassung und begrenzter Messgerätezeit.",
  "highlights": {
    "zielfunktion": [
      {"text": "Feinstaubmessung kostet {c1} €", "bedeutung": "{c1} × x₁"},
      {"text": "Gasspektroskopie kostet {c2} €", "bedeutung": "{c2} × x₂"}
    ],
    "nebenbedingungen": [
      [
        {"text": "{a11} % der Schadstoffe", "bedeutung": "{a11}x₁"},
        {"text": "{a12} % der Schadstoffe", "bedeutung": "+ {a12}x₂"},
        {"text": "{b1} %", "bedeutung": "≥ {b1}"}
      ],
      [
        {"text": "{a21} Stunden", "bedeutung": "{a21}x₁"},
        {"text": "{a22} Stunden", "bedeutung": "+ {a22}x₂"},
        {"text": "{b2} Stunden", "bedeutung": "≤ {b2}"}
      ]
    ]
  }
}
