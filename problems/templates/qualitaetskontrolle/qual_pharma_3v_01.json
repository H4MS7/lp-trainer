{
  "id": "qual_pharma_3v_01",
  "typ": "Qualitätskontrolle",
  "optimierungsziel": "minimieren",
  "numVars": 3,
  "variablen": ["x1 = Anzahl HPLC-Analysen", "x2 = Anzahl Massenspektrometrien", "x3 = Anzahl Stabilitätstests"],
  "objective": ["c1", "c2", "c3"],
  "constraints": [
