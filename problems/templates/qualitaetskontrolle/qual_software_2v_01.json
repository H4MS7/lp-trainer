{
  "id": "qual_software_2v_01",
  "typ": "Qualitätskontrolle",
  "optimierungsziel": "minimieren",
  "numVars": 2,
  "variablen": ["x1 = Anzahl automatisierte Tests", "x2 = Anzahl manuelle Tests"],
  "objective": ["c1", "c2"],
  "constraints": [
    {"type": ">=", "label": "Mindest-Codeabdeckung", "row": ["a11","a12"], "rhs": "b1"},
    {"type": "<=", "label": "Testzeit", "row": ["a21","a22"], "rhs": "b2"}
  ],
  "coefficients": {
    "c1":  {"min": 1, "max": 5,   "label": "Kosten automatisiert (€/Test)"},
    "c2":  {"min": 4, "max": 12,  "label": "Kosten manuell (€/Test)"},
    "a11": {"min": 2, "max": 6,   "label": "Codeabdeckung automatisiert (%)"},
    "a12": {"min": 3, "max": 8,   "label": "Codeabdeckung manuell (%)"},
    "b1":  {"min": 40, "max": 160, "label": "Mindest-Codeabdeckung (%)"},
    "a21": {"min": 1, "max": 2,   "label": "Testzeit automatisiert (min)"},
    "a22": {"min": 3, "max": 8,   "label": "Testzeit manuell (min)"},
    "b2":  {"min": 30, "max": 120, "label": "Testzeit (min)"}
  },
  "titel": "Softwaretest – Qualitätssicherung",
  "beschreibung": "Ein Softwareunternehmen kombiniert automatisierte und manuelle Tests. Ein automatisierter Test kostet {c1} €, ein manueller Test kostet {c2} €. Automatisierte Tests erreichen {a11} % Codeabdeckung, manuelle Tests erreichen {a12} % Codeabdeckung. Die Mindest-Codeabdeckung beträgt {b1} %. Ein automatisierter Test dauert {a21} Minuten, ein manueller Test dauert {a22} Minuten. Die verfügbare Testzeit beträgt {b2} Minuten.",
  "hinweis": "Minimiere die Testkosten bei ausreichender Codeabdeckung und begrenzter Testzeit.",
  "highlights": {
    "zielfunktion": [
      {"text": "automatisierter Test kostet {c1} €", "bedeutung": "{c1} × x₁"},
      {"text": "manueller Test kostet {c2} €", "bedeutung": "{c2} × x₂"}
    ],
    "nebenbedingungen": [
      [
        {"text": "{a11} % Codeabdeckung", "bedeutung": "{a11}x₁"},
        {"text": "{a12} % Codeabdeckung", "bedeutung": "+ {a12}x₂"},
        {"text": "{b1} %", "bedeutung": "≥ {b1}"}
      ],
      [
        {"text": "{a21} Minuten", "bedeutung": "{a21}x₁"},
        {"text": "{a22} Minuten", "bedeutung": "+ {a22}x₂"},
        {"text": "{b2} Minuten", "bedeutung": "≤ {b2}"}
      ]
    ]
  }
}
