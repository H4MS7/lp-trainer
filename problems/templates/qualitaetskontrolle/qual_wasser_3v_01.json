        {"text": "{a12} %", "bedeutung": "+ {a12}x₂"},
        {"text": "{a13} % der Parameter", "bedeutung": "+ {a13}x₃"},
        {"text": "{b1} %", "bedeutung": "≥ {b1}"}
      ],
      [
        {"text": "{a21} Stunden Laborzeit", "bedeutung": "{a21}x₁"},
        {"text": "{a22} Stunden", "bedeutung": "+ {a22}x₂"},
        {"text": "{a23} Stunden", "bedeutung": "+ {a23}x₃"},
        {"text": "{b2} Stunden", "bedeutung": "≤ {b2}"}
      ],
      [
        {"text": "{a31} € pro chemische Analyse", "bedeutung": "{a31}x₁"},
        {"text": "{a32} € pro mikrobiologischen Test", "bedeutung": "+ {a32}x₂"},
        {"text": "{a33} € pro physikalische Messung", "bedeutung": "+ {a33}x₃"},
