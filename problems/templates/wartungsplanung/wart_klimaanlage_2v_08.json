{
  "id": "wart_klimaanlage_2v_08",
  "typ": "Wartungsplanung",
  "optimierungsziel": "minimieren",
  "numVars": 2,
  "variablen": ["x1 = Anzahl Filterwechsel", "x2 = Anzahl Kompressorreparaturen"],
  "objective": ["c1", "c2"],
  "constraints": [
    {"type": ">=", "label": "Mindestkühlleistung", "row": ["a11","a12"], "rhs": "b1"},
