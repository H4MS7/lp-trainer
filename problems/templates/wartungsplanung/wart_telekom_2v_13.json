        {"text": "{b1} %", "bedeutung": "≥ {b1}"}
      ],
      [
        {"text": "{a21} Funktechnikerstunden", "bedeutung": "{a21}x₁"},
        {"text": "{a22} Funktechnikerstunden", "bedeutung": "+ {a22}x₂"},
        {"text": "{b2} Funktechnikerstunden stehen zur Verfügung", "bedeutung": "≤ {b2}"}
      ]
    ]
  }
