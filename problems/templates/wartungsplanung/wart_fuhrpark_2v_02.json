{
  "id": "wart_fuhrpark_2v_02",
  "typ": "Wartungsplanung",
  "optimierungsziel": "minimieren",
  "numVars": 2,
  "variablen": ["x1 = Anzahl Inspektionen", "x2 = Anzahl Notfallreparaturen"],
  "objective": ["c1", "c2"],
  "constraints": [
    {"type": ">=", "label": "Mindestzuverlässigkeit", "row": ["a11","a12"], "rhs": "b1"},
