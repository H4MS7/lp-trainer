{
  "id": "wart_medizin_2v_05",
  "typ": "Wartungsplanung",
  "optimierungsziel": "minimieren",
  "numVars": 2,
  "variablen": ["x1 = Anzahl Kalibrierungen", "x2 = Anzahl Notfallwartungen"],
  "objective": ["c1", "c2"],
  "constraints": [
    {"type": ">=", "label": "Mindestgenauigkeit", "row": ["a11","a12"], "rhs": "b1"},
    {"type": "<=", "label": "Technikerstunden", "row": ["a21","a22"], "rhs": "b2"}
  ],
  "coefficients": {
    "c1":  {"min": 3, "max": 10,  "label": "Kosten Kalibrierung (Tsd. €)"},
    "c2":  {"min": 8, "max": 20,  "label": "Kosten Notfallwartung (Tsd. €)"},
    "a11": {"min": 4, "max": 12,  "label": "Genauigkeit Kalibrierung (%)"},
    "a12": {"min": 2, "max": 6,   "label": "Genauigkeit Notfall (%)"},
    "b1":  {"min": 40, "max": 140, "label": "Mindestgenauigkeit (%)"},
    "a21": {"min": 2, "max": 6,   "label": "Stunden Kalibrierung (h)"},
    "a22": {"min": 4, "max": 10,  "label": "Stunden Notfall (h)"},
    "b2":  {"min": 25, "max": 100, "label": "Max. Technikerstunden (h)"}
  },
  "titel": "Klinik – Medizingeräte-Wartung",
  "beschreibung": "Eine Klinik plant die Wartung ihrer Medizingeräte. Eine Kalibrierung kostet {c1} Tsd. €, eine Notfallwartung kostet {c2} Tsd. €. Eine Kalibrierung verbessert die Genauigkeit um {a11} %, eine Notfallwartung um {a12} %. Die Mindestgenauigkeit beträgt {b1} %. Eine Kalibrierung benötigt {a21} Technikerstunden, eine Notfallwartung benötigt {a22} Technikerstunden. Maximal {b2} Technikerstunden stehen zur Verfügung.",
  "hinweis": "Minimiere die Wartungskosten bei Einhaltung der Genauigkeit und Personalkapazität.",
  "highlights": {
    "zielfunktion": [
      {"text": "Kalibrierung kostet {c1} Tsd. €", "bedeutung": "{c1} × x₁"},
      {"text": "Notfallwartung kostet {c2} Tsd. €", "bedeutung": "{c2} × x₂"}
    ],
    "nebenbedingungen": [
      [
        {"text": "{a11} %", "bedeutung": "{a11}x₁"},
        {"text": "{a12} %", "bedeutung": "+ {a12}x₂"},
        {"text": "{b1} %", "bedeutung": "≥ {b1}"}
      ],
      [
        {"text": "{a21} Technikerstunden", "bedeutung": "{a21}x₁"},
        {"text": "{a22} Technikerstunden", "bedeutung": "+ {a22}x₂"},
        {"text": "{b2} Technikerstunden stehen zur Verfügung", "bedeutung": "≤ {b2}"}
      ]
    ]
  }
}
