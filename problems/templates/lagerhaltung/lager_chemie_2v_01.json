        {"text": "{a21} Schrankfächer pro Fass", "bedeutung": "{a21}x₁"},
        {"text": "{a22} Schrankfächer pro Fass", "bedeutung": "+ {a22}x₂"},
        {"text": "{b2} Fächer", "bedeutung": "≤ {b2}"}
      ]
    ]
  }
