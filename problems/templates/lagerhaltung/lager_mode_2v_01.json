      [
        {"text": "{a21} m² Stellfläche pro Karton", "bedeutung": "{a21}x₁"},
        {"text": "{a22} m² Stellfläche pro Karton", "bedeutung": "+ {a22}x₂"},
        {"text": "{b2} m²", "bedeutung": "≤ {b2}"}
      ]
    ]
  }
}
