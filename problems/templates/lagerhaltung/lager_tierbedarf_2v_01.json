{
  "id": "lager_tierbedarf_2v_01",
  "typ": "Lagerhaltung",
  "optimierungsziel": "minimieren",
  "numVars": 2,
  "variablen": ["x1 = Bestellmenge Trockenfutter (Säcke)", "x2 = Bestellmenge Nassfutter (Kartons)"],
  "objective": ["c1", "c2"],
  "constraints": [
    {"type": ">=", "label": "Mindestfutterbestand", "row": ["a11","a12"], "rhs": "b1"},
