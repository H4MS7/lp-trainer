  ],
  "coefficients": {
    "c1":  {"min": 2, "max": 8,   "label": "Durchsatz Standard (Req/s)"},
    "c2":  {"min": 5, "max": 15,  "label": "Durchsatz High-Perf (Req/s)"},
    "a11": {"min": 1, "max": 4,   "label": "CPU Standard (Kerne)"},
    "a12": {"min": 2, "max": 8,   "label": "CPU High-Perf (Kerne)"},
    "b1":  {"min": 40, "max": 200, "label": "Verfügbare CPU-Kerne"},
    "a21": {"min": 2, "max": 8,   "label": "RAM Standard (GB)"},
    "a22": {"min": 4, "max": 16,  "label": "RAM High-Perf (GB)"},
