{
  "id": "ress_personal_2v_15",
  "typ": "Ressourcenallokation",
  "optimierungsziel": "maximieren",
  "numVars": 2,
  "variablen": ["x1 = Mitarbeiter im Innendienst", "x2 = Mitarbeiter im Außendienst"],
  "objective": ["c1", "c2"],
  "constraints": [
    {"type": "<=", "label": "Gesamtpersonal", "row": ["a11","a12"], "rhs": "b1"},
