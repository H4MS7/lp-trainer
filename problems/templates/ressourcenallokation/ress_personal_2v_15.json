  ],
  "coefficients": {
    "c1":  {"min": 3, "max": 10,    "label": "Produktivität/Mitarbeiter Innen"},
    "c2":  {"min": 5, "max": 15,    "label": "Produktivität/Mitarbeiter Außen"},
    "a11": {"min": 1, "max": 1,     "label": "Personalslot Innen"},
    "a12": {"min": 1, "max": 1,     "label": "Personalslot Außen"},
    "b1":  {"min": 10, "max": 50,   "label": "Personalbudget (Stellen)"},
    "a21": {"min": 3, "max": 8,     "label": "Bürofläche/Mitarbeiter Innen (m²)"},
    "a22": {"min": 1, "max": 3,     "label": "Bürofläche/Mitarbeiter Außen (m²)"},
    "b2":  {"min": 30, "max": 150,  "label": "Bürofläche (m²)"}
  },
  "titel": "Personalplanung – Innendienst und Außendienst",
  "beschreibung": "Die Geschäftsleitung verteilt Stellen auf Innendienst und Außendienst. Jeder Innendienstmitarbeiter erbringt eine Produktivität von {c1} Einheiten, jeder Außendienstmitarbeiter {c2} Einheiten. Jede Innenstelle benötigt {a11} Personalslot, jede Außenstelle {a12} Personalslot. Es stehen {b1} Stellen zur Verfügung. Im Büro benötigt ein Innendienstler {a21} m² Fläche, ein Außendienstler {a22} m². Die Bürofläche beträgt {b2} m².",
  "hinweis": "Maximiere die Produktivität mit Personal- und Bürofläche als Beschränkungen.",
  "highlights": {
    "zielfunktion": [
      {"text": "Innendienstmitarbeiter erbringt eine Produktivität von {c1} Einheiten", "bedeutung": "{c1} × x₁"},
      {"text": "Außendienstmitarbeiter {c2} Einheiten", "bedeutung": "{c2} × x₂"}
    ],
    "nebenbedingungen": [
      [
        {"text": "Innenstelle benötigt {a11} Personalslot", "bedeutung": "{a11}x₁"},
        {"text": "Außenstelle {a12} Personalslot", "bedeutung": "+ {a12}x₂"},
        {"text": "{b1} Stellen zur Verfügung", "bedeutung": "≤ {b1}"}
      ],
      [
        {"text": "Innendienstler {a21} m²", "bedeutung": "{a21}x₁"},
        {"text": "Außendienstler {a22} m²", "bedeutung": "+ {a22}x₂"},
        {"text": "{b2} m²", "bedeutung": "≤ {b2}"}
      ]
    ]
  }
}
