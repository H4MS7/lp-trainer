      [
        {"text": "{a21} Stunden pro Aktieneinheit", "bedeutung": "{a21}x₁"},
        {"text": "{a22} Stunden pro Immobilieneinheit", "bedeutung": "+ {a22}x₂"},
        {"text": "{b2} Verwaltungsstunden bereit", "bedeutung": "≤ {b2}"}
      ]
    ]
  }
