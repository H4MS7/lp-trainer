{
  "id": "diaet_diabetes_2v_12",
  "typ": "Diätproblem",
  "optimierungsziel": "minimieren",
  "numVars": 2,
  "variablen": ["x1 = Portionen Lachs", "x2 = Portionen Brokkoli"],
  "objective": ["c1", "c2"],
  "constraints": [
