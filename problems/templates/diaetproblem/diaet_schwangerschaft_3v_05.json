      [
        {"text": "{a21} µg Folsäure", "bedeutung": "{a21}x₁"},
        {"text": "{a22} µg Folsäure", "bedeutung": "+ {a22}x₂"},
        {"text": "{a23} µg Folsäure pro Portion", "bedeutung": "+ {a23}x₃"},
        {"text": "{b2} µg Folsäure werden benötigt", "bedeutung": "≥ {b2}"}
      ],
      [
