{
  "id": "diaet_reis_linsen_2v_01",
  "typ": "Diätproblem",
  "optimierungsziel": "minimieren",
  "numVars": 2,
  "variablen": ["x1 = Portionen Reis", "x2 = Portionen Linsen"],
  "objective": ["c1", "c2"],
  "constraints": [
    {"type": ">=", "label": "Protein", "row": ["a11","a12"], "rhs": "b1"},
    {"type": ">=", "label": "Kalorien", "row": ["a21","a22"], "rhs": "b2"}
  ],
  "coefficients": {
    "c1":  {"min": 1, "max": 5,   "label": "Kosten Reis (€/Portion)"},
    "c2":  {"min": 2, "max": 8,   "label": "Kosten Linsen (€/Portion)"},
    "a11": {"min": 2, "max": 8,   "label": "Protein Reis (g/Portion)"},
    "a12": {"min": 5, "max": 12,  "label": "Protein Linsen (g/Portion)"},
    "b1":  {"min": 40, "max": 120, "label": "Mindest-Protein (g)"},
    "a21": {"min": 100, "max": 250, "label": "Kalorien Reis (kcal/Portion)"},
    "a22": {"min": 80, "max": 200,  "label": "Kalorien Linsen (kcal/Portion)"},
    "b2":  {"min": 800, "max": 2000, "label": "Mindest-Kalorien (kcal)"}
  },
  "titel": "Ernährungsplan – Reis und Linsen",
  "beschreibung": "Ein Ernährungsberater plant eine kostengünstige Mahlzeit aus Reis und Linsen. Eine Portion Reis kostet {c1} €, eine Portion Linsen kostet {c2} €. Reis liefert {a11} g Protein pro Portion, Linsen liefern {a12} g Protein pro Portion. Mindestens {b1} g Protein werden benötigt. Reis enthält {a21} kcal pro Portion, Linsen enthalten {a22} kcal pro Portion. Der Tagesbedarf von mindestens {b2} kcal muss gedeckt werden.",
  "hinweis": "Minimiere die Kosten bei Einhaltung der Mindestanforderungen an Protein und Kalorien.",
  "highlights": {
    "zielfunktion": [
      {"text": "Reis kostet {c1} €", "bedeutung": "{c1} × x₁"},
      {"text": "Linsen kostet {c2} €", "bedeutung": "{c2} × x₂"}
    ],
    "nebenbedingungen": [
      [
        {"text": "{a11} g Protein pro Portion", "bedeutung": "{a11}x₁"},
        {"text": "{a12} g Protein pro Portion", "bedeutung": "+ {a12}x₂"},
        {"text": "{b1} g Protein werden benötigt", "bedeutung": "≥ {b1}"}
      ],
      [
        {"text": "{a21} kcal pro Portion", "bedeutung": "{a21}x₁"},
        {"text": "{a22} kcal pro Portion", "bedeutung": "+ {a22}x₂"},
        {"text": "{b2} kcal muss gedeckt werden", "bedeutung": "≥ {b2}"}
      ]
    ]
  }
}
