{
  "id": "diaet_sportcamp_3v_03",
  "typ": "Diätproblem",
  "optimierungsziel": "minimieren",
  "numVars": 3,
  "variablen": ["x1 = Portionen Müsli", "x2 = Portionen Joghurt", "x3 = Portionen Ei"],
  "objective": ["c1", "c2", "c3"],
  "constraints": [
    {"type": ">=", "label": "Protein", "row": ["a11","a12","a13"], "rhs": "b1"},
