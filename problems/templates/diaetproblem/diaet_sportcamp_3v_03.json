    "b2":  {"min": 60, "max": 140, "label": "Mindest-Kohlenhydrate (g)"},
    "a31": {"min": 2, "max": 5,   "label": "Kalzium Müsli (mg/Portion)"},
    "a32": {"min": 5, "max": 12,  "label": "Kalzium Joghurt (mg/Portion)"},
    "a33": {"min": 1, "max": 4,   "label": "Kalzium Ei (mg/Portion)"},
    "b3":  {"min": 40, "max": 90,  "label": "Mindest-Kalzium (mg)"}
  },
  "titel": "Sportcamp-Frühstück – Müsli, Joghurt und Ei",
  "beschreibung": "Ein Sportcamp plant das Frühstück möglichst kostengünstig aus Müsli, Joghurt und Ei. Müsli kostet {c1} € pro Portion, Joghurt kostet {c2} € pro Portion, Ei kostet {c3} € pro Portion. Müsli liefert {a11} g Protein, Joghurt liefert {a12} g Protein, Ei liefert {a13} g Protein pro Portion. Mindestens {b1} g Protein werden benötigt. Müsli enthält {a21} g Kohlenhydrate, Joghurt enthält {a22} g Kohlenhydrate, Ei enthält {a23} g Kohlenhydrate pro Portion. Mindestens {b2} g Kohlenhydrate sind nötig. Müsli liefert {a31} mg Kalzium, Joghurt liefert {a32} mg Kalzium, Ei liefert {a33} mg Kalzium pro Portion. Der Mindestbedarf an Kalzium beträgt {b3} mg.",
  "hinweis": "Minimiere die Frühstückskosten bei Einhaltung aller Mindestanforderungen.",
  "highlights": {
    "zielfunktion": [
      {"text": "Müsli kostet {c1} €", "bedeutung": "{c1} × x₁"},
      {"text": "Joghurt kostet {c2} €", "bedeutung": "{c2} × x₂"},
      {"text": "Ei kostet {c3} €", "bedeutung": "{c3} × x₃"}
    ],
    "nebenbedingungen": [
      [
        {"text": "{a11} g Protein", "bedeutung": "{a11}x₁"},
        {"text": "{a12} g Protein", "bedeutung": "+ {a12}x₂"},
        {"text": "{a13} g Protein pro Portion", "bedeutung": "+ {a13}x₃"},
        {"text": "{b1} g Protein werden benötigt", "bedeutung": "≥ {b1}"}
      ],
      [
        {"text": "{a21} g Kohlenhydrate", "bedeutung": "{a21}x₁"},
        {"text": "{a22} g Kohlenhydrate", "bedeutung": "+ {a22}x₂"},
        {"text": "{a23} g Kohlenhydrate pro Portion", "bedeutung": "+ {a23}x₃"},
        {"text": "{b2} g Kohlenhydrate sind nötig", "bedeutung": "≥ {b2}"}
      ],
      [
        {"text": "{a31} mg Kalzium", "bedeutung": "{a31}x₁"},
        {"text": "{a32} mg Kalzium", "bedeutung": "+ {a32}x₂"},
        {"text": "{a33} mg Kalzium pro Portion", "bedeutung": "+ {a33}x₃"},
        {"text": "{b3} mg", "bedeutung": "≥ {b3}"}
      ]
