    "c2":  {"min": 1, "max": 3,   "label": "Kosten Joghurt (€/Portion)"},
    "c3":  {"min": 1, "max": 3,   "label": "Kosten Ei (€/Portion)"},
    "a11": {"min": 2, "max": 6,   "label": "Protein Müsli (g/Portion)"},
    "a12": {"min": 3, "max": 8,   "label": "Protein Joghurt (g/Portion)"},
    "a13": {"min": 5, "max": 12,  "label": "Protein Ei (g/Portion)"},
    "b1":  {"min": 40, "max": 100, "label": "Mindest-Protein (g)"},
    "a21": {"min": 8, "max": 15,  "label": "Kohlenhydrate Müsli (g/Portion)"},
