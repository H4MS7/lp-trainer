      [
        {"text": "{a21} MJ Energie pro Einheit", "bedeutung": "{a21}x₁"},
        {"text": "{a22} MJ Energie pro Einheit", "bedeutung": "+ {a22}x₂"},
        {"text": "{b2} MJ", "bedeutung": "≥ {b2}"}
      ]
    ]
  }
