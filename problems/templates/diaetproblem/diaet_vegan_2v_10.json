  },
  "titel": "Veganer Ernährungsplan – Kichererbsen und Quinoa",
  "beschreibung": "Ein veganer Ernährungsplan soll möglichst kostengünstig sein. Eine Portion Kichererbsen kostet {c1} €, eine Portion Quinoa kostet {c2} €. Kichererbsen liefern {a11} g Protein pro Portion, Quinoa liefert {a12} g Protein pro Portion. Mindestens {b1} g Protein werden täglich benötigt. Kichererbsen enthalten {a21} mg Eisen pro Portion, Quinoa enthält {a22} mg Eisen pro Portion. Der Mindestbedarf an Eisen beträgt {b2} mg.",
  "hinweis": "Minimiere die täglichen Kosten des veganen Ernährungsplans bei Einhaltung der Mindestanforderungen.",
  "highlights": {
    "zielfunktion": [
      {"text": "Kichererbsen kostet {c1} €", "bedeutung": "{c1} × x₁"},
      {"text": "Quinoa kostet {c2} €", "bedeutung": "{c2} × x₂"}
    ],
    "nebenbedingungen": [
      [
        {"text": "{a11} g Protein pro Portion", "bedeutung": "{a11}x₁"},
        {"text": "{a12} g Protein pro Portion", "bedeutung": "+ {a12}x₂"},
        {"text": "{b1} g Protein werden täglich benötigt", "bedeutung": "≥ {b1}"}
      ],
      [
        {"text": "{a21} mg Eisen pro Portion", "bedeutung": "{a21}x₁"},
        {"text": "{a22} mg Eisen pro Portion", "bedeutung": "+ {a22}x₂"},
        {"text": "{b2} mg", "bedeutung": "≥ {b2}"}
      ]
    ]
  }
