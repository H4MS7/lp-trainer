    "a11": {"min": 5, "max": 12,  "label": "Protein Kichererbsen (g/Portion)"},
    "a12": {"min": 4, "max": 10,  "label": "Protein Quinoa (g/Portion)"},
    "b1":  {"min": 50, "max": 120, "label": "Mindest-Protein (g)"},
    "a21": {"min": 2, "max": 6,   "label": "Eisen Kichererbsen (mg/Portion)"},
