{
  "id": "diaet_huhn_tofu_2v_02",
  "typ": "Diätproblem",
  "optimierungsziel": "minimieren",
  "numVars": 2,
  "variablen": ["x1 = Portionen Hähnchen", "x2 = Portionen Tofu"],
  "objective": ["c1", "c2"],
  "constraints": [
    {"type": ">=", "label": "Protein", "row": ["a11","a12"], "rhs": "b1"},
    {"type": ">=", "label": "Eisen", "row": ["a21","a22"], "rhs": "b2"}
  ],
  "coefficients": {
    "c1":  {"min": 2, "max": 8,   "label": "Kosten Hähnchen (€/Portion)"},
    "c2":  {"min": 1, "max": 6,   "label": "Kosten Tofu (€/Portion)"},
    "a11": {"min": 8, "max": 15,  "label": "Protein Hähnchen (g/Portion)"},
    "a12": {"min": 4, "max": 10,  "label": "Protein Tofu (g/Portion)"},
    "b1":  {"min": 50, "max": 150, "label": "Mindest-Protein (g)"},
    "a21": {"min": 1, "max": 4,   "label": "Eisen Hähnchen (mg/Portion)"},
    "a22": {"min": 2, "max": 6,   "label": "Eisen Tofu (mg/Portion)"},
    "b2":  {"min": 10, "max": 30,  "label": "Mindest-Eisen (mg)"}
  },
  "titel": "Sportlerernährung – Hähnchen und Tofu",
  "beschreibung": "Ein Sportler möchte seinen Ernährungsplan möglichst günstig gestalten. Eine Portion Hähnchen kostet {c1} €, eine Portion Tofu kostet {c2} €. Hähnchen liefert {a11} g Protein pro Portion, Tofu liefert {a12} g Protein pro Portion. Er benötigt mindestens {b1} g Protein täglich. Hähnchen enthält {a21} mg Eisen pro Portion, Tofu enthält {a22} mg Eisen pro Portion. Der Mindestbedarf an Eisen beträgt {b2} mg.",
  "hinweis": "Minimiere die Gesamtkosten bei Einhaltung der Mindestmengen für Protein und Eisen.",
  "highlights": {
    "zielfunktion": [
      {"text": "Hähnchen kostet {c1} €", "bedeutung": "{c1} × x₁"},
      {"text": "Tofu kostet {c2} €", "bedeutung": "{c2} × x₂"}
    ],
    "nebenbedingungen": [
      [
        {"text": "{a11} g Protein pro Portion", "bedeutung": "{a11}x₁"},
        {"text": "{a12} g Protein pro Portion", "bedeutung": "+ {a12}x₂"},
        {"text": "{b1} g Protein täglich", "bedeutung": "≥ {b1}"}
      ],
      [
        {"text": "{a21} mg Eisen pro Portion", "bedeutung": "{a21}x₁"},
        {"text": "{a22} mg Eisen pro Portion", "bedeutung": "+ {a22}x₂"},
        {"text": "{b2} mg", "bedeutung": "≥ {b2}"}
      ]
    ]
  }
}
