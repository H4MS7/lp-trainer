{
  "id": "diaet_krankenhaus_3v_02",
  "typ": "Diätproblem",
  "optimierungsziel": "minimieren",
  "numVars": 3,
  "variablen": ["x1 = Portionen Suppe", "x2 = Portionen Fisch", "x3 = Portionen Pudding"],
  "objective": ["c1", "c2", "c3"],
  "constraints": [
    {"type": ">=", "label": "Protein", "row": ["a11","a12","a13"], "rhs": "b1"},
    {"type": ">=", "label": "Kalorien", "row": ["a21","a22","a23"], "rhs": "b2"},
    {"type": "<=", "label": "Fett", "row": ["a31","a32","a33"], "rhs": "b3"}
  ],
  "coefficients": {
    "c1":  {"min": 1, "max": 4,   "label": "Kosten Suppe (€/Portion)"},
    "c2":  {"min": 3, "max": 9,   "label": "Kosten Fisch (€/Portion)"},
    "c3":  {"min": 1, "max": 3,   "label": "Kosten Pudding (€/Portion)"},
    "a11": {"min": 2, "max": 5,   "label": "Protein Suppe (g/Portion)"},
    "a12": {"min": 8, "max": 15,  "label": "Protein Fisch (g/Portion)"},
    "a13": {"min": 1, "max": 4,   "label": "Protein Pudding (g/Portion)"},
    "b1":  {"min": 50, "max": 100, "label": "Mindest-Protein (g)"},
    "a21": {"min": 60, "max": 150, "label": "Kalorien Suppe (kcal/Portion)"},
    "a22": {"min": 100, "max": 250, "label": "Kalorien Fisch (kcal/Portion)"},
    "a23": {"min": 80, "max": 180,  "label": "Kalorien Pudding (kcal/Portion)"},
    "b2":  {"min": 800, "max": 1600, "label": "Mindest-Kalorien (kcal)"},
    "a31": {"min": 1, "max": 4,   "label": "Fett Suppe (g/Portion)"},
    "a32": {"min": 2, "max": 6,   "label": "Fett Fisch (g/Portion)"},
    "a33": {"min": 3, "max": 8,   "label": "Fett Pudding (g/Portion)"},
    "b3":  {"min": 40, "max": 80,  "label": "Maximal-Fett (g)"}
  },
  "titel": "Krankenhauskost – Suppe, Fisch und Pudding",
  "beschreibung": "Ein Krankenhaus plant die Patientenverpflegung aus Suppe, Fisch und Pudding. Suppe kostet {c1} € pro Portion, Fisch kostet {c2} € pro Portion, Pudding kostet {c3} € pro Portion. Suppe liefert {a11} g Protein, Fisch liefert {a12} g Protein, Pudding liefert {a13} g Protein pro Portion. Mindestens {b1} g Protein sind nötig. Suppe enthält {a21} kcal, Fisch enthält {a22} kcal, Pudding enthält {a23} kcal pro Portion. Mindestens {b2} kcal müssen erreicht werden. Suppe hat {a31} g Fett, Fisch hat {a32} g Fett, Pudding hat {a33} g Fett pro Portion. Höchstens {b3} g Fett sind erlaubt.",
  "hinweis": "Minimiere die Verpflegungskosten bei Einhaltung der Protein- und Kalorienmindestmengen sowie der Fettobergrenze.",
  "highlights": {
    "zielfunktion": [
      {"text": "Suppe kostet {c1} €", "bedeutung": "{c1} × x₁"},
      {"text": "Fisch kostet {c2} €", "bedeutung": "{c2} × x₂"},
      {"text": "Pudding kostet {c3} €", "bedeutung": "{c3} × x₃"}
    ],
    "nebenbedingungen": [
      [
        {"text": "{a11} g Protein", "bedeutung": "{a11}x₁"},
        {"text": "{a12} g Protein", "bedeutung": "+ {a12}x₂"},
        {"text": "{a13} g Protein pro Portion", "bedeutung": "+ {a13}x₃"},
        {"text": "{b1} g Protein sind nötig", "bedeutung": "≥ {b1}"}
      ],
      [
        {"text": "{a21} kcal", "bedeutung": "{a21}x₁"},
        {"text": "{a22} kcal", "bedeutung": "+ {a22}x₂"},
        {"text": "{a23} kcal pro Portion", "bedeutung": "+ {a23}x₃"},
        {"text": "{b2} kcal müssen erreicht werden", "bedeutung": "≥ {b2}"}
      ],
      [
        {"text": "{a31} g Fett", "bedeutung": "{a31}x₁"},
        {"text": "{a32} g Fett", "bedeutung": "+ {a32}x₂"},
        {"text": "{a33} g Fett pro Portion", "bedeutung": "+ {a33}x₃"},
        {"text": "{b3} g Fett sind erlaubt", "bedeutung": "≤ {b3}"}
      ]
    ]
  }
}
