{
  "id": "diaet_krankenhaus_2v_03",
  "typ": "Diätproblem",
  "optimierungsziel": "minimieren",
  "numVars": 2,
  "variablen": ["x1 = Portionen Kartoffelbrei", "x2 = Portionen Gemüsesuppe"],
  "objective": ["c1", "c2"],
  "constraints": [
    {"type": ">=", "label": "Kalorien", "row": ["a11","a12"], "rhs": "b1"},
    {"type": ">=", "label": "Vitamin C", "row": ["a21","a22"], "rhs": "b2"}
  ],
  "coefficients": {
    "c1":  {"min": 1, "max": 4,   "label": "Kosten Kartoffelbrei (€/Portion)"},
    "c2":  {"min": 2, "max": 6,   "label": "Kosten Gemüsesuppe (€/Portion)"},
    "a11": {"min": 150, "max": 300, "label": "Kalorien Kartoffelbrei (kcal/Portion)"},
    "a12": {"min": 80, "max": 180,  "label": "Kalorien Gemüsesuppe (kcal/Portion)"},
    "b1":  {"min": 800, "max": 1800, "label": "Mindest-Kalorien (kcal)"},
    "a21": {"min": 2, "max": 8,   "label": "Vitamin C Kartoffelbrei (mg/Portion)"},
    "a22": {"min": 5, "max": 15,  "label": "Vitamin C Gemüsesuppe (mg/Portion)"},
    "b2":  {"min": 30, "max": 90,  "label": "Mindest-Vitamin C (mg)"}
  },
  "titel": "Krankenhausküche – Kartoffelbrei und Gemüsesuppe",
  "beschreibung": "Die Krankenhausküche plant ein kostengünstiges Menü aus Kartoffelbrei und Gemüsesuppe. Eine Portion Kartoffelbrei kostet {c1} €, eine Portion Gemüsesuppe kostet {c2} €. Kartoffelbrei liefert {a11} kcal pro Portion, Gemüsesuppe liefert {a12} kcal pro Portion. Mindestens {b1} kcal müssen pro Patient bereitgestellt werden. Kartoffelbrei enthält {a21} mg Vitamin C pro Portion, Gemüsesuppe enthält {a22} mg Vitamin C pro Portion. Der Mindestbedarf an Vitamin C beträgt {b2} mg.",
  "hinweis": "Minimiere die Kosten pro Patient bei Einhaltung der Mindestanforderungen an Kalorien und Vitamin C.",
  "highlights": {
    "zielfunktion": [
      {"text": "Kartoffelbrei kostet {c1} €", "bedeutung": "{c1} × x₁"},
      {"text": "Gemüsesuppe kostet {c2} €", "bedeutung": "{c2} × x₂"}
    ],
    "nebenbedingungen": [
      [
        {"text": "{a11} kcal pro Portion", "bedeutung": "{a11}x₁"},
        {"text": "{a12} kcal pro Portion", "bedeutung": "+ {a12}x₂"},
        {"text": "{b1} kcal müssen pro Patient bereitgestellt werden", "bedeutung": "≥ {b1}"}
      ],
      [
        {"text": "{a21} mg Vitamin C pro Portion", "bedeutung": "{a21}x₁"},
        {"text": "{a22} mg Vitamin C pro Portion", "bedeutung": "+ {a22}x₂"},
        {"text": "{b2} mg", "bedeutung": "≥ {b2}"}
      ]
    ]
  }
}
