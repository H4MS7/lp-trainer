    "a11": {"min": 200, "max": 350, "label": "Kalorien Energieriegel (kcal/Ration)"},
    "a12": {"min": 150, "max": 280, "label": "Kalorien Eintopf (kcal/Ration)"},
    "b1":  {"min": 1500, "max": 2500, "label": "Mindest-Kalorien (kcal)"},
    "a21": {"min": 3, "max": 8,   "label": "Protein Energieriegel (g/Ration)"},
