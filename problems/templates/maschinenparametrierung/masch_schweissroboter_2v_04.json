    "zielfunktion": [
      {
        "text": "Stromstärke liefert {c1} Punkte Nahtfestigkeit",
        "bedeutung": "{c1} × x₁"
      },
      {
        "text": "Drahtvorschub {c2} Punkte Schweißgeschwindigkeit",
        "bedeutung": "{c2} × x₂"
      }
    ],
    "nebenbedingungen": [
      [
        {
          "text": "{a11} Einheiten pro Stromstufe",
          "bedeutung": "{a11}x₁"
        },
        {
          "text": "{a12} Einheiten pro Drahtstufe",
          "bedeutung": "+ {a12}x₂"
