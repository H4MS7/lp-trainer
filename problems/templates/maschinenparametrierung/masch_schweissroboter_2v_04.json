    "c2": {
      "min": 3,
      "max": 10,
      "label": "Schweißgeschwindigkeit Draht"
    },
    "a11": {
      "min": 3,
      "max": 10,
      "label": "Energie pro Stromstufe"
    },
    "a12": {
      "min": 1,
      "max": 5,
