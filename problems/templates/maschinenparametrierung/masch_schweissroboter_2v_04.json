        {
          "text": "{b1} Energieeinheiten",
          "bedeutung": "≤ {b1}"
        }
      ],
      [
        {
          "text": "{a21} Einheiten pro Stromstufe",
          "bedeutung": "{a21}x₁"
        },
        {
          "text": "{a22} Einheiten pro Drahtstufe",
          "bedeutung": "+ {a22}x₂"
        },
        {
          "text": "{b2} Spritzereinheiten",
          "bedeutung": "≤ {b2}"
        }
      ]
    ]
