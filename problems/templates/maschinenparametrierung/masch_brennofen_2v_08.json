      {
        "text": "Brenndauer {c2} Punkte Gleichmäßigkeit",
        "bedeutung": "{c2} × x₂"
      }
    ],
    "nebenbedingungen": [
      [
        {
          "text": "{a11} Einheiten pro Temperaturstufe",
          "bedeutung": "{a11}x₁"
        },
        {
          "text": "{a12} Einheiten pro Dauerstufe",
          "bedeutung": "+ {a12}x₂"
        },
        {
          "text": "{b1} Gaseinheiten",
          "bedeutung": "≤ {b1}"
        }
      ],
      [
        {
          "text": "{a21} Einheiten pro Temperaturstufe",
          "bedeutung": "{a21}x₁"
        },
        {
          "text": "{a22} Einheiten pro Dauerstufe",
          "bedeutung": "+ {a22}x₂"
        },
        {
          "text": "{b2} Belastungseinheiten",
