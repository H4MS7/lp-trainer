  "id": "masch_spritzguss_2v_06",
  "titel": "Spritzgussmaschine – Einspritzdruck und Nachdruckzeit",
  "variablen": [
    "x1 = Einspritzdruck (Stufen)",
    "x2 = Nachdruckzeit (Stufen)"
  ],
  "constraints": [
    {
      "type": "<=",
      "label": "Hydraulikleistung",
      "row": [
        "a11",
        "a12"
      ],
