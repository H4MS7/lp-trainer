  "highlights": {
    "zielfunktion": [
      {
        "text": "Temperatur trägt {c1} Punkte zur Homogenität bei",
        "bedeutung": "{c1} × x₁"
      },
      {
        "text": "Schneckendrehzahl {c2} Punkte zum Durchsatz",
        "bedeutung": "{c2} × x₂"
      }
    ],
    "nebenbedingungen": [
      [
        {
          "text": "{a11} Einheiten pro Temperaturstufe",
          "bedeutung": "{a11}x₁"
        },
        {
          "text": "{a12} Einheiten pro Drehzahlstufe",
          "bedeutung": "+ {a12}x₂"
        },
        {
          "text": "{b1} Energieeinheiten",
          "bedeutung": "≤ {b1}"
        }
      ],
      [
        {
          "text": "{a21} Einheiten pro Temperaturstufe",
          "bedeutung": "{a21}x₁"
        },
        {
          "text": "{a22} Einheiten pro Drehzahlstufe",
          "bedeutung": "+ {a22}x₂"
        },
        {
          "text": "{b2} Belastungseinheiten",
          "bedeutung": "≤ {b2}"
        }
      ]
