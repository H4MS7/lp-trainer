      "min": 5,
      "max": 13,
      "label": "Durchsatz Drehzahl"
    },
    "a11": {
      "min": 4,
      "max": 10,
      "label": "Energie pro Temperaturstufe"
    },
    "a12": {
      "min": 2,
      "max": 6,
