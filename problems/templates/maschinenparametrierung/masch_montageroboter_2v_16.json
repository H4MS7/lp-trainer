    "c2"
  ],
  "id": "masch_montageroboter_2v_16",
  "titel": "Montageroboter – Greifkraft und Verfahrgeschwindigkeit",
  "variablen": [
    "x1 = Greifkraft (Stufen)",
    "x2 = Verfahrgeschwindigkeit (Stufen)"
  ],
  "constraints": [
    {
      "type": "<=",
      "label": "Stromverbrauch",
      "row": [
        "a11",
        "a12"
      ],
      "rhs": "b1"
