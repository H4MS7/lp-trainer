        }
      ],
      [
        {
          "text": "{a21} Einheiten pro Geschwindigkeitsstufe",
          "bedeutung": "{a21}x₁"
        },
        {
          "text": "{a22} Einheiten pro Druckstufe",
          "bedeutung": "+ {a22}x₂"
